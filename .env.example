# ─────────────────────────────────────────────────────────────────────────────
#  WGtech AI Starter Kit — Metis Compute Board (SBC)
#
#  setup.sh generates a real .env from this file and fills in the values it can
#  detect (gateway IP, SDK path, shared HLS dir). You normally do not edit this
#  by hand.
# ─────────────────────────────────────────────────────────────────────────────

# ── Container images ─────────────────────────────────────────────────────────
REGISTRY=wgtechsolutions1
TAG=latest

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info                 # debug | info | warning | error

# Board runs UTC by default. IP cameras usually burn in local time, so the
# timestamp in the video and the board clock will differ unless you set this.
TZ=UTC

# ── Data paths (inside the backend container) ────────────────────────────────
DATA_DIR=data
MODELS_DIR=data/models
RECORDINGS_DIR=data/recordings
EVENTS_DIR=data/events
HLS_DIR=data/hls

# ── Inference ────────────────────────────────────────────────────────────────
INFERENCE_MODE=real            # real | mock

# The Voyager-SDK container is host-networked, so the backend reaches it at the
# docker bridge gateway. The gateway is pinned to 172.22.0.1 in
# docker-compose.yml, so this stays valid across reboots.
VOYAGER_SDK_URL=http://172.22.0.1:8001
MEDIAMTX_HOST=172.22.0.1
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554

# Detected by setup.sh from the Voyager-SDK container.
VOYAGER_SDK_DIR=/home/ubuntu/voyager-sdk
VOYAGER_CONTAINER=Voyager-SDK

# Host side of the SDK's shared mount, used to hand annotated HLS from the
# Voyager-SDK container to the backend. Detected by setup.sh.
SHARED_HLS_DIR=

# ── AIPU ─────────────────────────────────────────────────────────────────────
# The Metis AIPU on this board has 4 cores. Model YAMLs commonly ship with
# aipu_cores: 1, which caps inference at roughly a quarter of the available
# throughput and becomes the bottleneck as soon as you add a second camera.
# This runtime flag overrides the YAML.
AIPU_CORES=4

# ── RTSP ─────────────────────────────────────────────────────────────────────
# UDP by default: several IP cameras reset an RTSP-over-TCP session after a
# couple of seconds. Switch to tcp only if your camera requires it.
RTSP_TRANSPORT=udp

# ── HLS (used for recording; the live view uses MJPEG) ───────────────────────
HLS_SEGMENT_DURATION=1
HLS_PLAYLIST_SIZE=5

# ── CORS (same-origin in production; only needed for dev) ────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173
